local function AddConnection(Signal, Function)
	if (not OrionLib:IsRunning()) then
		return
	end
	local SignalConnect = Signal:Connect(Function)
	table.insert(OrionLib.Connections, SignalConnect)
	return SignalConnect
end

local function DisconnectAll()
	for Index = #OrionLib.Connections, 1, -1 do
		local Connection = OrionLib.Connections[Index]
		if Connection then
			Connection:Disconnect()
		end
		OrionLib.Connections[Index] = nil
	end
end

Orion.AncestryChanged:Connect(function(_, Parent)
	if not Parent then
		DisconnectAll()
	end
end)

local function AddDraggingFunctionality(DragPoint, Main)
	pcall(function()
		local Dragging, DragInput, MousePos, FramePos = false
		AddConnection(DragPoint.InputBegan, function(Input)
			if IsPointerInput(Input) then
				Dragging = true
				MousePos = Input.Position
				FramePos = Main.Position
			end
		end)
		AddConnection(DragPoint.InputChanged, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
				DragInput = Input
			end
		end)
		AddConnection(UserInputService.InputChanged, function(Input)
			if Input == DragInput and Dragging then
				local Delta = Input.Position - MousePos
				Main.Position = UDim2.new(FramePos.X.Scale, FramePos.X.Offset + Delta.X, FramePos.Y.Scale, FramePos.Y.Offset + Delta.Y)
			end
		end)
		AddConnection(UserInputService.InputEnded, function(Input)
			if IsPointerInput(Input) then
				Dragging = false
			end
		end)
	end)
end   

local function Create(Name, Properties, Children)
	local Object = Instance.new(Name)
	for i, v in next, Properties or {} do
		Object[i] = v
	end
	for i, v in next, Children or {} do
		v.Parent = Object
	end
	return Object
end

local function CreateElement(ElementName, ElementFunction)
	OrionLib.Elements[ElementName] = function(...)
		return ElementFunction(...)
	end
end

local function MakeElement(ElementName, ...)
	local Factory = OrionLib.Elements[ElementName]
	if not Factory then
		warn(("Orion Library - Tried to create unregistered element '%s'."):format(tostring(ElementName)))
		return Create("Frame", {
			Name = tostring(ElementName),
			BackgroundTransparency = 1,
			BorderSizePixel = 0
		})
	end
	return Factory(...)
end

local function SetProps(Element, Props)
	for Property, Value in pairs(Props) do
		Element[Property] = Value
	end
	return Element
end

local function SetChildren(Element, Children)
	for _, Child in pairs(Children) do
		Child.Parent = Element
	end
	return Element
end

local function Round(Number, Factor)
	local Result = math.floor(Number/Factor + (math.sign(Number) * 0.5)) * Factor
	if Result < 0 then Result = Result + Factor end
	return Result
end

local function ReturnProperty(Object)
	if Object:IsA("Frame") or Object:IsA("TextButton") then
		return "BackgroundColor3"
	end 
	if Object:IsA("ScrollingFrame") then
		return "ScrollBarImageColor3"
	end 
	if Object:IsA("UIStroke") then
		return "Color"
	end 
	if Object:IsA("TextLabel") or Object:IsA("TextBox") then
		return "TextColor3"
	end   
	if Object:IsA("ImageLabel") or Object:IsA("ImageButton") then
		return "ImageColor3"
	end   
end

local function AddThemeObject(Object, Type)
	if not OrionLib.ThemeObjects[Type] then
		OrionLib.ThemeObjects[Type] = {}
	end    
	table.insert(OrionLib.ThemeObjects[Type], Object)
	Object[ReturnProperty(Object)] = OrionLib.Themes[OrionLib.SelectedTheme][Type]
	return Object
end    

local function SetTheme()
	for Name, Type in pairs(OrionLib.ThemeObjects) do
		for Index = #Type, 1, -1 do
			local Object = Type[Index]
			local Property = Object and ReturnProperty(Object)
			if not Object or not Object.Parent or not Property then
				table.remove(Type, Index)
			else
				Object[Property] = OrionLib.Themes[OrionLib.SelectedTheme][Name]
			end
		end    
	end    
end

function OrionLib:RegisterTheme(Name, Theme)
	if type(Name) ~= "string" or type(Theme) ~= "table" then
		return false
	end

	OrionLib.Themes[Name] = MergeThemePalette(OrionLib.Themes.Default, Theme)
	return true
end

function OrionLib:CreateTheme(Name, Theme)
	return self:RegisterTheme(Name, Theme)
end

function OrionLib:SetTheme(Name)
	if not OrionLib.Themes[Name] then
		return false
	end

	OrionLib.SelectedTheme = Name
	SetTheme()
	return true
end

function OrionLib:Theme(Name)
	return self:SetTheme(Name)
end

function OrionLib:UseTheme(Name)
	return self:SetTheme(Name)
end

function OrionLib:GetThemeKeys()
	local Keys = {}
	for Key in pairs(OrionLib.Themes.Default) do
		table.insert(Keys, Key)
	end
	return Keys
end

function OrionLib:SetThemeColor(ThemeName, Key, Value)
	if type(ThemeName) ~= "string" or type(Key) ~= "string" then
		return false
	end

	if not OrionLib.Themes[ThemeName] then
		OrionLib.Themes[ThemeName] = MergeThemePalette(OrionLib.Themes.Default, {})
	end

	if not OrionLib.Themes.Default[Key] then
		return false
	end

	OrionLib.Themes[ThemeName][Key] = Value
	if OrionLib.SelectedTheme == ThemeName then
		SetTheme()
	end
	return true
end

function OrionLib:GetTheme(Name)
	if type(Name) ~= "string" then
		return OrionLib.Themes[OrionLib.SelectedTheme]
	end
	return OrionLib.Themes[Name] or OrionLib.Themes[OrionLib.SelectedTheme]
end

function OrionLib:ApplyThemePreset(Name)
	if type(Name) ~= "string" then
		return false
	end

	if not OrionLib.Themes[Name] then
		return false
	end

	return self:SetTheme(Name)
end

function OrionLib:ApplyGradient(Object, ColorA, ColorB, Rotation)
	if not Object or not Object:IsA("GuiObject") then
		return Object
	end

	local Gradient = Object:FindFirstChildOfClass("UIGradient")
	if not Gradient then
		Gradient = Create("UIGradient", {
			Rotation = Rotation or 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, ColorA or Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, ColorB or ColorA or Color3.fromRGB(255, 255, 255))
			})
		})
		Gradient.Parent = Object
	else
		Gradient.Rotation = Rotation or Gradient.Rotation or 90
		Gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ColorA or Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, ColorB or ColorA or Color3.fromRGB(255, 255, 255))
		})
	end

	return Object
end

function OrionLib:ApplyShadow(Object, Color, Transparency, Size)
	if not Object or not Object:IsA("GuiObject") then
		return Object
	end

	local Shadow = Object:FindFirstChild("OrionShadow")
	if not Shadow then
		Shadow = Create("ImageLabel", {
			Name = "OrionShadow",
			Image = "rbxassetid://1316045217",
			ScaleType = Enum.ScaleType.Slice,
			SliceCenter = Rect.new(10, 10, 118, 118),
			BackgroundTransparency = 1,
			ImageColor3 = Color or Color3.fromRGB(0, 0, 0),
			ImageTransparency = Transparency or 0.78,
			BorderSizePixel = 0,
			ZIndex = -1,
			Size = UDim2.new(1, (Size or 18), 1, (Size or 18)),
			Position = UDim2.new(0, -(Size or 18)/2, 0, -(Size or 18)/2),
			Parent = Object
		})
	else
		Shadow.ImageColor3 = Color or Shadow.ImageColor3 or Color3.fromRGB(0, 0, 0)
		Shadow.ImageTransparency = Transparency or Shadow.ImageTransparency or 0.78
		Shadow.Size = UDim2.new(1, (Size or 18), 1, (Size or 18))
		Shadow.Position = UDim2.new(0, -(Size or 18)/2, 0, -(Size or 18)/2)
	end

	return Object
end

function OrionLib:ApplyGlass(Object, Color, Transparency, Strength)
	if not Object or not Object:IsA("GuiObject") then
		return Object
	end

	Object.BackgroundColor3 = Color or Color3.fromRGB(255, 255, 255)
	Object.BackgroundTransparency = Transparency or 0.28

	local Stroke = Object:FindFirstChildOfClass("UIStroke") or Create("UIStroke", {
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0.45,
		Thickness = 1,
		Parent = Object
	})
	Stroke.Color = Color3.fromRGB(255, 255, 255)
	Stroke.Transparency = 0.45

	return Object
end

function OrionLib:Animate(Object, Properties, Duration, EasingStyle, Delay)
	if not Object or not Object:IsA("GuiObject") then
		return Object
	end

	local Tween = TweenService:Create(Object, TweenInfo.new(Duration or 0.3, EasingStyle or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Properties or {})
	if Delay and Delay > 0 then
		task.delay(Delay, function()
			Tween:Play()
		end)
		return Object
	end
	Tween:Play()
	return Object
end

local function PackColor(Color)
	return {R = Color.R * 255, G = Color.G * 255, B = Color.B * 255}
end    

local function UnpackColor(Color)
	return Color3.fromRGB(Color.R, Color.G, Color.B)
end

local function LoadCfg(Config)
	local Data = HttpService:JSONDecode(Config)
	for FlagName, Value in pairs(Data) do
		if OrionLib.Flags[FlagName] then
			task.spawn(function()
				if OrionLib.Flags[FlagName].Type == "Colorpicker" then
					OrionLib.Flags[FlagName]:Set(UnpackColor(Value))
				else
					OrionLib.Flags[FlagName]:Set(Value)
				end    
			end)
		else
			warn("Orion Library Config Loader - Could not find ", FlagName, Value)
		end
	end
end

local function SaveCfg(Name)
	if not HasFileSystem() or not OrionLib.Folder then
		return false
	end

	local Data = {}
	for FlagName, Flag in pairs(OrionLib.Flags) do
		if Flag.Save then
			if Flag.Type == "Colorpicker" then
				Data[FlagName] = PackColor(Flag.Value)
			else
				Data[FlagName] = Flag.Value
			end
		end
	end

	local Success = pcall(writefile, OrionLib.Folder .. "/" .. Name .. ".txt", HttpService:JSONEncode(Data))
	return Success
end

