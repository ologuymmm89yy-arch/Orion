		local function GetSearchText(Object)
			if not Object then
				return ""
			end
			local Text = ""
			if Object:IsA("TextLabel") or Object:IsA("TextButton") or Object:IsA("TextBox") then
				Text = tostring(Object.Text or "")
			end
			if Object:IsA("GuiObject") then
				Text = Text .. " " .. tostring(Object.Name or "")
			end
			return string.lower(Text)
		end

		local function DoesObjectMatch(Object, Query)
			if not Object or (not Object:IsA("GuiObject")) then
				return false
			end
			if Query == "" then
				return true
			end

			local function Visit(Node)
				if not Node or not Node:IsA("GuiObject") then
					return false
				end
				if string.find(GetSearchText(Node), Query, 1, true) then
					return true
				end
				for _, Child in ipairs(Node:GetChildren()) do
					if Visit(Child) then
						return true
					end
				end
				return false
			end

			return Visit(Object)
		end

		local function UpdateSearch()
			local Query = string.lower(SearchTextBox.Text or "")
			for _, ItemContainer in ipairs(MainWindow:GetChildren()) do
				if ItemContainer.Name ~= "ItemContainer" then
					continue
				end
				if Query == "" then
					ItemContainer.Visible = ItemContainer:IsDescendantOf(MainWindow)
					for _, Child in ipairs(ItemContainer:GetChildren()) do
						if Child:IsA("GuiObject") and Child.Name ~= "UIListLayout" and Child.Name ~= "UIPadding" then
							Child.Visible = true
						end
					end
					continue
				end
				local AnyMatch = false
				for _, Child in ipairs(ItemContainer:GetChildren()) do
					if Child:IsA("GuiObject") and Child.Name ~= "UIListLayout" and Child.Name ~= "UIPadding" then
						local SectionMatch = false
						if Child:FindFirstChild("Holder") then
							for _, HolderChild in ipairs(Child.Holder:GetChildren()) do
								if DoesObjectMatch(HolderChild, Query) then
									SectionMatch = true
									break
								end
							end
						else
							SectionMatch = DoesObjectMatch(Child, Query)
						end
						Child.Visible = SectionMatch
						if SectionMatch then
							AnyMatch = true
						end
					end
				end
				ItemContainer.Visible = AnyMatch
			end
		end

		local SearchUpdatePending = false
		local function ScheduleSearchUpdate()
			if SearchUpdatePending then
				return
			end
			SearchUpdatePending = true
			task.defer(function()
				SearchUpdatePending = false
				if SearchTextBox.Parent then
