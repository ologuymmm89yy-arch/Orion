local function MergeThemePalette(BaseTheme, OverrideTheme)
	local Merged = {}
	for Key, Value in pairs(BaseTheme or {}) do
		Merged[Key] = Value
	end
	if type(OverrideTheme) == "table" then
		for Key, Value in pairs(OverrideTheme) do
			Merged[Key] = Value
		end
	end
	return Merged
end

--Feather Icons https://github.com/evoincorp/lucideblox/tree/master/src/modules/util - Created by 7kayoh
local Icons = {}

local function LoadIcons()
	local Candidates = {
		"https://raw.githubusercontent.com/evoincorp/lucideblox/master/src/modules/util/icons.json",
		"https://raw.githubusercontent.com/7kayoh/lucideblox/master/src/modules/util/icons.json",
		"https://cdn.jsdelivr.net/gh/evoincorp/lucideblox@master/src/modules/util/icons.json"
	}

	for _, Url in ipairs(Candidates) do
		local Success, Response = pcall(function()
			local Body = FetchText(Url)
			if not Body then
				return nil
			end
			return HttpService:JSONDecode(Body)
		end)
		if Success and type(Response) == "table" then
			if Response.icons and type(Response.icons) == "table" then
				return Response.icons
			end
			if Response["icons"] and type(Response["icons"]) == "table" then
				return Response["icons"]
			end
		end
	end

	return {}
end

Icons = LoadIcons()
