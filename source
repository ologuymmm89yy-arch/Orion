function OrionLib:MakeNotification(NotificationConfig)
	NotificationConfig = NotificationConfig or {}
	task.spawn(function()
		NotificationConfig.Name = NotificationConfig.Name or "Notification"
		NotificationConfig.Content = NotificationConfig.Content or "Test"
		NotificationConfig.Image = NotificationConfig.Image or "rbxassetid://4384403532"
		NotificationConfig.Time = NotificationConfig.Time or 4
		NotificationConfig.Style = NotificationConfig.Style or "glass"

		while #OrionLib.Notifications >= OrionLib.NotificationLimit do
			local Oldest = table.remove(OrionLib.Notifications, 1)
			if Oldest and Oldest.Parent then
				Oldest:Destroy()
			end
		end

		local NotificationParent = SetProps(MakeElement("TFrame"), {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = NotificationHolder
		})

		local NotificationFrame = SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(28, 30, 36), 0, 14), {
			Parent = NotificationParent,
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.new(1, 20, 0, 0),
			BackgroundTransparency = 0.12,
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 40
		}), {
			MakeElement("Stroke", Color3.fromRGB(255, 255, 255), 1),
			MakeElement("Padding", 12, 12, 12, 12),
			SetProps(MakeElement("Image", NotificationConfig.Image), {
				Size = UDim2.new(0, 22, 0, 22),
				ImageColor3 = Color3.fromRGB(240, 240, 240),
				Name = "Icon",
