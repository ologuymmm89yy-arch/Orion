		if not AssetId then
			return nil
		end
		return {
			Type = Type,
			AssetId = AssetId,
			Looped = MediaConfig.Looped ~= false,
			Playing = MediaConfig.Playing ~= false,
			Transparency = MediaConfig.Transparency or MediaConfig.ImageTransparency or 0.35,
