		end
		local Resolved = ResolveBackgroundMedia(MediaConfig, MediaConfig.Type or MediaConfig.Kind or MediaConfig.Mode or "image")
		if not Resolved or not Resolved.AssetId then
			return false
		end
		if not BackgroundLayer then
			BackgroundLayer = Create("Frame", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 0,
				ClipsDescendants = true,
				Parent = MainWindow
			})
		end
		if BackgroundObject then
			BackgroundObject:Destroy()
		end
		if Resolved.Type == "video" then
			BackgroundObject = Create("VideoFrame", {
				Video = ToAssetId(Resolved.AssetId),
				Looped = Resolved.Looped,
				Playing = Resolved.Playing,
				Volume = Resolved.Volume,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 0,
				Visible = true,
				Parent = BackgroundLayer
			})
		else
			BackgroundObject = Create("ImageLabel", {
				Image = ToAssetId(Resolved.AssetId),
				ImageTransparency = Resolved.Transparency,
				ScaleType = Enum.ScaleType.Crop,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 0,
				Visible = true,
				Parent = BackgroundLayer
			})
		end
		BackgroundObject.Size = UDim2.fromScale(1, 1)
		BackgroundObject.Position = UDim2.fromScale(0, 0)
		BackgroundObject.AnchorPoint = Vector2.new(0, 0)
		MainWindow.BackgroundTransparency = WindowConfig.BackgroundOverlayTransparency or 0.18
		return true
	end

	function TabFunction:SetBackground(AssetId, IsVideo)
		local BackgroundType = IsVideo == true and "video" or "image"
		if type(AssetId) == "table" then
			return self:SetMedia(AssetId)
		end
		if not AssetId then
			return false
		end
		return self:SetMedia({Type = BackgroundType, AssetId = AssetId, Looped = true, Playing = true})
	end

	function TabFunction:SetBackgroundVisible(Visible)
		if BackgroundObject then
			BackgroundObject.Visible = Visible ~= false
			return true
		end
		return false
	end

	function TabFunction:SetMusic(AssetId)
		if not AssetId then
			Music:Stop()
			Music.SoundId = ""
			return false
		end
		Music.SoundId = ToAssetId(AssetId)
		return true
	end

	function TabFunction:PlayMusic()
		if Music.SoundId == "" then
			return false
		end
		Music:Play()
		return true
	end

	function TabFunction:PauseMusic()
		Music:Pause()
	end

	function TabFunction:StopMusic()
		Music:Stop()
	end

	function TabFunction:SetMusicVolume(Volume)
		Music.Volume = math.clamp(tonumber(Volume) or 0, 0, 10)
	end

	function TabFunction:AddAnimation(Object, Properties, Duration, EasingStyle, EasingDirection)
		if not Object or not Object:IsA("Instance") or type(Properties) ~= "table" then
			return nil
		end
		local Tween = TweenService:Create(Object, TweenInfo.new(
			Duration or 0.35,
			EasingStyle or Enum.EasingStyle.Quint,
			EasingDirection or Enum.EasingDirection.Out
		), Properties)
		Tween:Play()
		return Tween
	end

	TabFunction.Search = function(Query)
		if SearchTextBox then
			SearchTextBox.Text = Query or ""
		end
	end

	TabFunction.Toggle = function()
		MainWindow.Visible = not MainWindow.Visible
		if MainWindow.Visible then
			UIHidden = false
		else
			UIHidden = true
		end
	end

	TabFunction.Hide = function()
		MainWindow.Visible = false
		UIHidden = true
		if MobileReopen then
			MobileReopen.Visible = true
		end
	end

	TabFunction.Show = function()
		MainWindow.Visible = true
		UIHidden = false
		if MobileReopen then
			MobileReopen.Visible = false
		end
	end

